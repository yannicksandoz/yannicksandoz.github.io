node_modules/
dist/
dist-auteur/

# Sauvegardes d'avant-publication écrites par l'éditeur. Ce sont des copies
# entières de la galerie : elles feraient doubler le dépôt à chaque
# publication, et git est déjà l'historique. Elles servent quand git ne peut
# pas — un retour immédiat, sans ligne de commande.
content/.sauvegardes/

# Les MASTERS audio (wav, aiff, flac de studio) vivent ici, hors du dépôt :
# scripts/fragmente-sons.py et encode-sons.py les y cherchent (--sources,
# GALERIE_SOURCES). Ce qui part en ligne est une copie d'écoute encodée.
sources/

# Les paquets de l’application auteur (electron-builder), et l'information
# de build (commit, branche, date) que scripts/app-local.mjs écrit avant
app-dist/
app/build-info.json

# bancs éphémères (un _x.mjs à la racine ne se versionne pas)
/_*.mjs
