{
  "name": "galerie-3d",
  "private": true,
  "license": "SEE LICENSE IN engine/LICENSE",
  "author": "Yannick Sandoz",
  "version": "1.0.0-beta.1",
  "type": "module",
  "main": "app/main.cjs",
  "description": "Galerie d'art 3D immersive, statique et modulaire (Vite + Three.js + Web Audio)",
  "scripts": {
    "dev": "GALERIE_EDITOR=1 vite",
    "dev:visiteur": "vite",
    "build": "vite build && node scripts/genere-liste.mjs dist",
    "build:auteur": "GALERIE_EDITOR=1 vite build --outDir dist-auteur && node scripts/genere-liste.mjs dist-auteur",
    "preview": "vite preview",
    "preview:auteur": "vite preview --outDir dist-auteur",
    "check": "node scripts/check-visitor-build.mjs && node scripts/poids-build.mjs",
    "sonde:visuels": "node scripts/sonde-visuels.cjs",
    "sonde:editeur": "node scripts/sonde-editeur.cjs",
    "sonde:charge": "node scripts/sonde-charge.cjs",
    "sonde:basse-perf": "node scripts/sonde-basse-perf.cjs",
    "sonde:piece-sons": "node scripts/sonde-piece-sons.cjs",
    "sonde:poids-audio": "node scripts/sonde-poids-audio.cjs",
    "sonde:lumiere": "node scripts/sonde-lumiere.cjs",
    "sonde:lisere": "node scripts/sonde-lisere.cjs",
    "budget": "node scripts/budget-salles.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "library": "node scripts/generate-library.mjs",
    "test": "node scripts/tests.mjs",
    "wasm:audio": "clang --target=wasm32 -O3 -nostdlib -Wl,--no-entry -Wl,--export-dynamic -o engine/assets/wasm/console7.wasm engine/src/audio/console7.c",
    "app": "electron .",
    "app:build": "npm run build:auteur && electron-builder",
    "app:icone": "node scripts/genere-icone-app.mjs"
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "three": "0.166.1",
    "three-gpu-pathtracer": "^0.0.23",
    "three-mesh-bvh": "^0.9.14"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@pmndrs/assets": "^1.7.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jpeg-js": "^0.4.4",
    "lucide-static": "^1.34.0",
    "vite": "^5.3.4"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "electron@44.4.5": true
  },
  "build": {
    "appId": "ch.yannicksandoz.galerie.auteur",
    "productName": "Galerie auteur",
    "executableName": "galerie-auteur",
    "copyright": "Yannick Sandoz",
    "directories": {
      "output": "app-dist",
      "buildResources": "app"
    },
    "files": [
      "app/**",
      "dist-auteur/**",
      "!dist-auteur/.sauvegardes/**",
      "!**/*.map"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "app/icone.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/icone.png",
      "artifactName": "${productName}-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1036"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "app/icone.png",
      "category": "Graphics",
      "artifactName": "${productName}-${version}-linux.${ext}",
      "desktopName": "galerie-auteur.desktop",
      "syncDesktopName": true
    },
    "publish": null
  }
}
